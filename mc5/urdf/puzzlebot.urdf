<?xml version="1.0"?>

<robot name="puzzle_drone">

   <link name="base_footprint" />

   <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://mc5/meshes/Puzzlebot_Jetson_Lidar_Edition_Base.stl"/>  
            </geometry>
            <material name="green">
                <color rgba="0.0 0.8 0.1 1.0"/>
            </material>
        </visual>
    </link>


   <link name="wheel_l">
        <visual>
            <origin xyz="0 0 -0.004" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="package://mc5/meshes/Puzzlebot_Wheel.stl"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.1 0.8 1.0"/>
            </material>
        </visual>
    </link>

  <link name="wheel_r">
        <visual>
            <origin xyz="0 0 -0.004" rpy="-1.57 0 0"/>
            <geometry>
                <mesh filename="package://mc5/meshes/Puzzlebot_Wheel.stl"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.1 0.8 1.0"/>
            </material>
        </visual>
    </link>

    <link name="caster">
        <visual>
            <origin xyz="0.0 0 -0.014" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://mc5/meshes/Puzzlebot_Caster_Wheel.stl"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.8 0.05 1.0"/>
            </material>
        </visual>
    </link>



    <joint name="base_footprint_base_link" type="fixed"> <!--Declare Joint element 'name' and 'type' (revolute, continuos, prismatic, fixed)-->
        <parent link="base_footprint"/>              <!--parent: Parent link name -->
        <child link="base_link"/>               <!--child: child link name -->
        <origin xyz="0 0.05 -0.03" rpy="0 0 0" />  <!--origin: This is the transform from the parent link to the child link xyz: xyz offset rpy:rotaton offset (radians)-->
    </joint>

    <joint name="base_wheel_l" type="continuous">
        <parent link="base_link"/> 
        <child link="wheel_l"/> 
        <origin xyz="0.052 0.095 -0.0025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="base_wheel_r" type="continuous">
        <parent link="base_link"/> 
        <child link="wheel_r"/> 
        <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="caster_joint" type="fixed"> <!--Declare Joint element 'name' and 'type' (revolute, continuos, prismatic, fixed)-->
        <parent link="base_link"/>              <!--parent: Parent link name -->
        <child link="caster"/>               <!--child: child link name -->
        <origin xyz="-0.09 0.0 -0.03" rpy="0 0 0" />  <!--origin: This is the transform from the parent link to the child link xyz: xyz offset rpy:rotaton offset (radians)-->
    </joint>



</robot>